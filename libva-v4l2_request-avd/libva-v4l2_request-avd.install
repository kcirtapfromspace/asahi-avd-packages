post_install() {
  cat <<'MSG'
==> libva cannot auto-select this driver on Apple Silicon (it derives the
    driver name from the DRM render node, which points at asahi). Select it
    explicitly for the session, e.g. in /etc/environment:

        LIBVA_DRIVER_NAME=v4l2_request

==> mpv:      mpv --hwdec=vaapi video.mp4
==> Firefox:  additionally needs MOZ_DISABLE_RDD_SANDBOX=1, because the RDD
              sandbox blocks the /dev/video* and /dev/media* access this
              driver requires. That weakens Firefox's media sandbox.
MSG
}

post_upgrade() {
  post_install
}
